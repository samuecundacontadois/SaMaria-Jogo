import Phaser from 'phaser';
import { State } from './systems/state.js';
import Boot from './scenes/Boot.js';
import Menu from './scenes/Menu.js';
import Select from './scenes/Select.js';
import Customize from './scenes/Customize.js';
import Sorting from './scenes/Sorting.js';
import Hall from './scenes/Hall.js';
import UI from './scenes/UI.js';

const game = new Phaser.Game({
  type: Phaser.AUTO, width: 960, height: 540, parent: 'game', backgroundColor: '#000000',
  pixelArt: true, roundPixels: true,
  physics: { default: 'arcade', arcade: { debug: false } },
  scale: { mode: Phaser.Scale.FIT, autoCenter: Phaser.Scale.CENTER_BOTH },
  scene: [Boot, Menu, Select, Customize, Sorting, Hall, UI], // UI por último = sempre por cima
});
window.__samaria = { State, game };
window.addEventListener('beforeunload', () => State.save());
